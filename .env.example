# Docker Compose automatically reads .env. Spring Boot and Vite do not.
# Optional advanced configuration only. Prefer scripts/start-docker.ps1 to avoid a credential file.
# Never commit a real .env. See docs/DOCKER.md for Docker metadata limitations.
DB_PASSWORD=replace-with-a-unique-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
APP_PORT=8088
# Use true when serving through HTTPS. Local HTTP requires false.
COOKIE_SECURE=false
# Host-run backend also supports DB_URL, DB_USER, PORT, SERVER_ADDRESS.
# Set those as shell environment variables, or use the start script below.
